{
  "name": "startup-hiring-signal-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A self-healing scraper that tracks open roles across startup careers pages spanning three different ATS/layout families, built on Bright Data Scraper Studio.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "scraper:create": "tsx scraper/run-cli.ts create",
    "scraper:run": "tsx scraper/run-cli.ts run",
    "scraper:heal": "tsx scraper/run-cli.ts heal",
    "scraper:approve": "tsx scraper/run-cli.ts approve",
    "validate": "tsx validator/run-validate.ts",
    "validate:test": "tsx validator/run-tests.ts",
    "orchestrate": "tsx orchestrator/orchestrate.ts",
    "orchestrate:demo": "tsx orchestrator/orchestrate.ts --target=demo",
    "demo:test": "tsx demo-page/run-tests.ts",
    "skills-demo:test": "tsx skills-demo/run-self-heal-test.ts",
    "mini-heal-demo:test": "tsx mini-heal-demo/run-self-heal-test.ts",
    "resume:generate": "tsx resume-tailor/generate.ts",
    "orchestrate:test": "tsx orchestrator/run-tests.ts",
    "state:seed": "tsx orchestrator/seed-state-from-recon.ts",
    "audit:view": "tsx orchestrator/view-audit-log.ts",
    "downstream:sync": "tsx downstream/run-sync.ts",
    "downstream:test": "tsx downstream/run-tests.ts",
    "timeline:build": "tsx downstream/build-timeline.ts",
    "jobs:build": "tsx downstream/build-jobs-page.ts",
    "dev": "echo \"placeholder - Phase 6+: local dev entrypoint\" && exit 0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  }
}
